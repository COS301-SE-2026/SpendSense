# Database
POSTGRES_USER=spendsense
POSTGRES_PASSWORD=replace_me_postgres_password
POSTGRES_DB=spendsense_dev
DATABASE_URL=postgresql://spendsense:replace_me_postgres_password@postgres:5432/spendsense_dev

# Backend
PORT=3000
AI_SERVICE_URL=http://ai:8000
SUPABASE_URL=replace_me_supabase_url
SUPABASE_JWT_SECRET=replace_me_supabase_jwt_secret
ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=replace_me_supabase_url
VITE_SUPABASE_ANON_KEY=replace_me_supabase_anon_key
SUPABASE_TEST_EMAIL=replace_me_test_email
SUPABASE_TEST_PASSWORD=replace_me_test_password
DEMO_USER_EMAIL=replace_me_demo_email
DEMO_SUPABASE_AUTH_ID=replace_me_supabase_auth_user_id
DEMO_DISPLAY_NAME=Demo Student

# Local S3-compatible storage
MINIO_ROOT_USER=localuser
MINIO_ROOT_PASSWORD=replace_me_minio_password
S3_BUCKET=receipts
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true

# Production only do not worry about this(docker-compose.prod.yml + Caddyfile) - These are in no way used in local dev
# CADDY_HOSTNAME becomes the backend's public URL, e.g. api-<EC2_PUBLIC_IP>.sslip.io
CADDY_HOSTNAME=replace_me_api_hostname
CADDY_ACME_EMAIL=replace_me_team_contact_email
