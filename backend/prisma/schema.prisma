generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Currency {
  ZAR
  USD
  EUR
  GBP
}

enum CategoryType {
  OBLIGATION
  EXPENSE
  BOTH
}

enum ObligationType {
  RENT
  SUBSCRIPTION
  BNPL
  UTILITY
  IOU
  CUSTOM
}

enum ObligationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ObligationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScheduleFrequency {
  ONCE
  WEEKLY
  MONTHLY
  FIXED_INSTALLMENT
}

enum PaymentOccurrenceStatus {
  PENDING
  PAID
  PAID_LATE
  OVERDUE
  MISSED
  CANCELLED
  PARTIALLY_PAID
}

enum PaymentRecordStatus {
  ON_TIME
  LATE
}

enum ReminderChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum NotificationType {
  REMINDER
  SCORE_CHANGE
  REWARD
  BADGE_EARNED
  PAYMENT_STATUS
  WAGER_INVITE
  WAGER_RESULT
  SYSTEM
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum WagerStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

enum WagerTaskType {
  ALL_PAYMENTS_ON_TIME
  NO_MISSED_PAYMENTS
  MAINTAIN_PAYMENT_STREAK
}

enum WagerOutcome {
  WON
  LOST
  DRAW
}

enum ScoreTier {
  BUILDING
  FAIR
  GOOD
  EXCELLENT
  ELITE
}

enum ScoreEventType {
  PAYMENT_ON_TIME
  PAYMENT_LATE
  PAYMENT_OVERDUE
  PAYMENT_MISSED
  MANUAL_ADJUSTMENT
}

enum MascotMood {
  HAPPY
  NEUTRAL
  STRESSED
  SAD
  CELEBRATING
}

enum UserEventType {
  USER_CREATED
  OBLIGATION_CREATED
  PAYMENT_LOGGED
  PAYMENT_ON_TIME
  PAYMENT_LATE
  PAYMENT_OVERDUE
  QUIZ_COMPLETED
  SCORE_UPDATED
  REWARD_GRANTED
  BADGE_EARNED
  SIMULATION_COMPLETED
}

enum UserEventSourceType {
  USER
  FINANCIAL_OBLIGATION
  PAYMENT_OCCURRENCE
  PAYMENT_RECORD
  SCORE_EVENT
  QUIZ
  REWARD_TRANSACTION
  BADGE
  SYSTEM
  SIMULATION_SESSION
}

enum QuizTopic {
  BUDGETING
  CREDIT_SCORE
  INTEREST
  DEBT
  BNPL
  SUBSCRIPTIONS
}

enum QuizSessionType {
  DAILY
  TOPIC
}

enum QuizSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RewardTransactionType {
  EARNED
  SPENT
  ADJUSTED
}

enum BadgeCategory {
  PAYMENT
  STREAK
  OBLIGATION
  SCORE
  QUIZ
  DEMO
}

enum BadgeCriteriaType {
  FIRST_OBLIGATION
  FIRST_ON_TIME_PAYMENT
  PAYMENT_STREAK_COUNT
  SCORE_REACHED
  QUIZ_COMPLETED_COUNT
  KNOWLEDGE_STREAK_COUNT
  SIMULATION_COMPLETION_COUNT
}

enum SimulationSessionStatus {
  BRIEFING
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
  EXPIRED
}

enum SimulationObligationStatus {
  SCHEDULED
  PAYABLE
  PAID
  MISSED
}

enum SimulationObligationImportance {
  CRITICAL
  HIGH
  STANDARD
  LOW
}

enum SimulationObligationScheduleStatus {
  SCHEDULED
  MATERIALIZED
}

enum SimulationEventStatus {
  SCHEDULED
  REVEALED
  RESOLVED
  EXPIRED
}

enum SimulationScoreSourceType {
  OBLIGATION_PAYMENT
  OBLIGATION_MISSED
  INSTALLMENT_MISSED
  EVENT_DECISION
  EVENT_EXPIRY
  FEE_OR_DEBT
  FINAL_BUDGET_BONUS
}

enum SimulationActionType {
  CREATE_SIMULATION
  SETUP
  ADVANCE_DAY
  PAY_OBLIGATION
  RESOLVE_EVENT
  CONTINUE
  CHANGE_STATUS
  DISCARD
}

enum SimulationPresentationHold {
  NONE
  PAYMENT_RESULT
  EVENT_REVEAL
  EVENT_RESULT
  SUMMARY
}

enum PaymentContributionSource {
  MANUAL
  RECEIPT_SCAN
}

enum PaymentContributionState {
  POSTED
  VOIDED
}

enum ReceiptScanStatus {
  READY_FOR_REVIEW
  CONSUMED
  EXPIRED
}

enum GuidanceWalkthroughStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model User {
  id                     String                  @id @default(uuid())
  supabaseAuthId         String                  @unique
  email                  String                  @unique
  displayName            String?                 @unique
  avatarUrl              String?
  monthlyBudget          Decimal?                @db.Decimal(12, 2)
  onboardingCompleted    Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  preference             UserPreference?
  notificationPreference NotificationPreference?
  creditProfile          CreditProfile?
  gamificationProfile    GamificationProfile?
  guidanceState          GuidanceState?
  obligations            FinancialObligation[]
  paymentOccurrences     PaymentOccurrence[]
  paymentRecords         PaymentRecord[]
  paymentContributions   PaymentContribution[]
  receiptScans           ReceiptScan[]
  reminders              Reminder[]
  notifications          Notification[]
  scoreEvents            ScoreEvent[]
  userEvents             UserEvent[]
  rewardTransactions     RewardTransaction[]
  badges                 UserBadge[]
  quizSessions           QuizSession[]
  inventoryItems         UserInventoryItem[]
  sentFriendRequests     FriendRequest[]         @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]         @relation("FriendRequestReceiver")
  friendships            Friendship[]            @relation("FriendshipUser")
  friendOf               Friendship[]            @relation("FriendshipFriend")
  wagersCreated          Wager[]                 @relation("WagersCreated")
  wagersReceived         Wager[]                 @relation("WagersReceived")
  simulationSessions     SimulationSession[]

  @@index([email])
  @@index([deletedAt])
}

model UserPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  theme         Theme    @default(SYSTEM)
  currency      Currency @default(ZAR)
  language      String   @default("en")
  reducedMotion Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuidanceState {
  id                    String                    @id @default(uuid())
  userId                String                    @unique
  tipsEnabled           Boolean                   @default(true)
  dailyExpansionEnabled Boolean                   @default(true)
  walkthroughStatus     GuidanceWalkthroughStatus @default(NOT_STARTED)
  walkthroughStep       Int                       @default(0)
  dismissedTipIds       Json                      @default("[]")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model NotificationPreference {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  emailEnabled              Boolean  @default(true)
  pushEnabled               Boolean  @default(false)
  smsEnabled                Boolean  @default(false)
  inAppEnabled              Boolean  @default(true)
  defaultReminderDaysBefore Int      @default(3)
  quietHoursStart           String?
  quietHoursEnd             String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String                @id @default(uuid())
  name        String
  type        CategoryType          @default(BOTH)
  iconKey     String?
  colourKey   String?
  isDefault   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  obligations FinancialObligation[]

  @@unique([name, type])
  @@index([isDefault])
}

model FinancialObligation {
  id                   String                @id @default(uuid())
  userId               String
  categoryId           String
  name                 String
  description          String?
  type                 ObligationType
  status               ObligationStatus      @default(ACTIVE)
  amount               Decimal               @db.Decimal(12, 2)
  currency             Currency              @default(ZAR)
  priority             ObligationPriority    @default(MEDIUM)
  startDate            DateTime
  endDate              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  schedules            PaymentSchedule[]
  occurrences          PaymentOccurrence[]
  payments             PaymentRecord[]
  paymentContributions PaymentContribution[]

  @@index([userId, deletedAt])
  @@index([userId, type])
  @@index([userId, status])
  @@index([categoryId])
}

model PaymentSchedule {
  id                        String              @id @default(uuid())
  obligationId              String
  frequency                 ScheduleFrequency
  interval                  Int                 @default(1)
  dayOfMonth                Int?
  dayOfWeek                 Int?
  startDate                 DateTime
  endDate                   DateTime?
  totalOccurrences          Int?
  occurrencesGeneratedUntil DateTime?
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  obligation                FinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  occurrences               PaymentOccurrence[]

  @@index([obligationId])
  @@index([isActive])
}

model PaymentOccurrence {
  id                       String                  @id @default(uuid())
  userId                   String
  obligationId             String
  scheduleId               String
  dueDate                  DateTime
  amountDue                Decimal                 @db.Decimal(12, 2)
  amountPaid               Decimal                 @default(0) @db.Decimal(12, 2)
  currency                 Currency                @default(ZAR)
  status                   PaymentOccurrenceStatus @default(PENDING)
  sequenceNumber           Int
  paidAt                   DateTime?
  overdueAt                DateTime?
  missedAt                 DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  deletedAt                DateTime?
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  obligation               FinancialObligation     @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  schedule                 PaymentSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  payment                  PaymentRecord?
  reminders                Reminder[]
  scoreEvents              ScoreEvent[]
  contributions            PaymentContribution[]
  receiptScanPreselections ReceiptScan[]           @relation("ReceiptScanPreselection")

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([obligationId])
  @@index([scheduleId])
  @@index([deletedAt])
}

model PaymentContribution {
  id                 String                    @id @default(uuid())
  userId             String
  occurrenceId       String
  obligationId       String
  amount             Decimal                   @db.Decimal(12, 2)
  currency           Currency
  paidDate           DateTime
  source             PaymentContributionSource
  state              PaymentContributionState  @default(POSTED)
  receiptScanId      String?                   @unique
  notes              String?
  idempotencyKey     String
  requestPayloadHash String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  voidedAt           DateTime?
  voidReason         String?
  voidedByUserId     String?

  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurrence PaymentOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  obligation FinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  receiptScan ReceiptScan? @relation("ReceiptScanContribution", fields: [receiptScanId], references: [id], onDelete: SetNull)

  scoreEvents ScoreEvent[]

  @@unique([userId, idempotencyKey])
  @@index([occurrenceId, state, createdAt])
  @@index([userId, createdAt])
  @@index([obligationId])
  @@index([state])
}

model ReceiptScan {
  id                      String            @id @default(uuid())
  userId                  String
  status                  ReceiptScanStatus @default(READY_FOR_REVIEW)
  preselectedOccurrenceId String?
  extraction              Json
  warnings                Json?
  expiresAt               DateTime
  consumedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  preselectedOccurrence PaymentOccurrence?   @relation("ReceiptScanPreselection", fields: [preselectedOccurrenceId], references: [id], onDelete: SetNull)
  contribution          PaymentContribution? @relation("ReceiptScanContribution")

  @@index([userId, expiresAt])
  @@index([status, expiresAt])
}

model PaymentRecord {
  id                String              @id @default(uuid())
  userId            String
  occurrenceId      String              @unique
  obligationId      String
  amountPaid        Decimal             @db.Decimal(12, 2)
  currency          Currency            @default(ZAR)
  paidDate          DateTime
  paymentStatus     PaymentRecordStatus
  daysLate          Int                 @default(0)
  simulatedInterest Decimal             @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurrence        PaymentOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  obligation        FinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  scoreEvents       ScoreEvent[]

  @@index([userId, paidDate])
  @@index([userId, paymentStatus])
  @@index([obligationId])
  @@index([deletedAt])
}

model Reminder {
  id           String             @id @default(uuid())
  userId       String
  occurrenceId String
  channel      ReminderChannel    @default(IN_APP)
  scheduledFor DateTime
  sentAt       DateTime?
  status       ReminderStatus     @default(SCHEDULED)
  priority     ObligationPriority @default(MEDIUM)
  message      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurrence   PaymentOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([userId, scheduledFor])
  @@index([userId, status])
  @@index([occurrenceId])
  @@index([deletedAt])
}

model Notification {
  id         String               @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  sourceType UserEventSourceType?
  sourceId   String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  deletedAt  DateTime?
  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@index([userId, type])
  @@index([sourceType, sourceId])
  @@index([deletedAt])
}

model CreditProfile {
  id                      String       @id @default(uuid())
  userId                  String       @unique
  currentScore            Int          @default(600)
  previousScore           Int          @default(600)
  scoreTier               ScoreTier    @default(GOOD)
  onTimePaymentCount      Int          @default(0)
  latePaymentCount        Int          @default(0)
  missedPaymentCount      Int          @default(0)
  currentUtilisationScore Decimal?     @db.Decimal(5, 2)
  lastCalculatedAt        DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?
  user                    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  scoreEvents             ScoreEvent[]

  @@index([scoreTier])
  @@index([deletedAt])
}

model ScoreEvent {
  id                    String               @id @default(uuid())
  userId                String
  creditProfileId       String
  occurrenceId          String?
  paymentRecordId       String?
  paymentContributionId String?
  eventType             ScoreEventType
  pointsDelta           Int
  scoreBefore           Int
  scoreAfter            Int
  explanation           String
  calculationMetadata   Json?
  createdAt             DateTime             @default(now())
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditProfile         CreditProfile        @relation(fields: [creditProfileId], references: [id], onDelete: Restrict)
  occurrence            PaymentOccurrence?   @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  paymentRecord         PaymentRecord?       @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  paymentContribution   PaymentContribution? @relation(fields: [paymentContributionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([creditProfileId])
  @@index([eventType])
}

model QuizQuestion {
  id               String              @id @default(uuid())
  topic            QuizTopic
  prompt           String
  options          Json
  correctOptionKey String
  explanation      String
  difficulty       Int                 @default(1)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessionAnswers   QuizSessionAnswer[]

  @@index([topic, isActive])
}

model QuizSession {
  id             String              @id @default(uuid())
  userId         String
  type           QuizSessionType
  topic          QuizTopic?
  quizDate       DateTime?
  status         QuizSessionStatus   @default(IN_PROGRESS)
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  score          Int                 @default(0)
  totalQuestions Int
  questionIds    String[]            @default([])
  coinsAwarded   Int                 @default(0)
  xpAwarded      Int                 @default(0)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers        QuizSessionAnswer[]

  @@unique([userId, type, quizDate])
  @@index([userId, status])
  @@index([userId, quizDate])
}

model QuizSessionAnswer {
  id                String       @id @default(uuid())
  sessionId         String
  questionId        String
  selectedOptionKey String
  isCorrect         Boolean
  attemptNumber     Int
  answeredAt        DateTime     @default(now())
  session           QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([sessionId, answeredAt])
  @@index([questionId])
}

model GamificationProfile {
  id                      String     @id @default(uuid())
  userId                  String     @unique
  coinBalance             Int        @default(0)
  xp                      Int        @default(0)
  mascotLevel             Int        @default(1)
  mascotMood              MascotMood @default(NEUTRAL)
  mascotMoodUpdatedAt     DateTime?
  currentPaymentStreak    Int        @default(0)
  longestPaymentStreak    Int        @default(0)
  currentKnowledgeStreak  Int        @default(0)
  longestKnowledgeStreak  Int        @default(0)
  lastKnowledgeStreakDate DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?
  user                    User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([mascotMood])
  @@index([deletedAt])
}

model UserEvent {
  id                 String              @id @default(uuid())
  userId             String
  eventType          UserEventType
  sourceType         UserEventSourceType
  sourceId           String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewardTransactions RewardTransaction[]

  @@index([userId, createdAt])
  @@index([eventType])
  @@index([sourceType, sourceId])
}

model RewardTransaction {
  id            String                @id @default(uuid())
  userId        String
  sourceEventId String?
  type          RewardTransactionType
  amount        Int
  balanceAfter  Int
  reason        String
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceEvent   UserEvent?            @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sourceEventId])
  @@index([type])
}

model BadgeDefinition {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  description   String
  category      BadgeCategory
  criteriaType  BadgeCriteriaType
  criteriaValue Int               @default(1)
  bonusCoins    Int               @default(0)
  iconKey       String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userBadges    UserBadge[]

  @@index([category])
  @@index([isActive])
}

model UserBadge {
  id                String          @id @default(uuid())
  userId            String
  badgeDefinitionId String
  progress          Int             @default(0)
  earnedAt          DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  badgeDefinition   BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([userId, badgeDefinitionId])
  @@index([userId, earnedAt])
  @@index([badgeDefinitionId])
}

enum CosmeticSlot {
  HAT
  ACCESSORY
}

model CosmeticItem {
  id             String              @id @default(uuid())
  code           String              @unique
  name           String
  slot           CosmeticSlot
  cost           Int
  iconKey        String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  inventoryItems UserInventoryItem[]

  @@index([slot, isActive])
}

model UserInventoryItem {
  id             String       @id @default(uuid())
  userId         String
  cosmeticItemId String
  purchasedAt    DateTime     @default(now())
  equipped       Boolean      @default(false)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticItem   CosmeticItem @relation(fields: [cosmeticItemId], references: [id], onDelete: Restrict)

  @@unique([userId, cosmeticItemId])
  @@index([userId, equipped])
}

model SimulationObligationTemplate {
  id                           String                         @id @default(uuid())
  code                         String                         @unique
  contentVersion               String                         @default("v1")
  name                         String
  category                     String
  amountDue                    Decimal                        @db.Decimal(12, 2)
  dueDay                       Int
  basePoints                   Decimal                        @db.Decimal(12, 2)
  savingsPointsFactor          Decimal                        @default(0.8) @db.Decimal(5, 2)
  importance                   SimulationObligationImportance @default(STANDARD)
  importanceWeight             Decimal                        @default(1.0) @db.Decimal(5, 2)
  baseMissPenalty              Decimal                        @default(20.0) @db.Decimal(12, 2)
  selectionWeight              Int                            @default(1)
  eligibleForEventIntroduction Boolean                        @default(false)
  isActive                     Boolean                        @default(true)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt

  @@index([isActive, selectionWeight])
  @@index([isActive, dueDay])
}

model SimulationEventTemplate {
  id              String   @id @default(uuid())
  code            String   @unique
  contentVersion  String   @default("v1")
  triggerDay      Int
  eventSnapshot   Json
  selectionWeight Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, selectionWeight])
  @@index([isActive, triggerDay])
}

model SimulationSession {
  id                         String                     @id @default(uuid())
  userId                     String
  status                     SimulationSessionStatus    @default(BRIEFING)
  scenarioVersion            String
  scenarioSnapshot           Json
  timedMode                  Boolean
  currentDay                 Int                        @default(0)
  daysInMonth                Int                        @default(30)
  startingBudget             Decimal                    @db.Decimal(12, 2)
  currentBalance             Decimal                    @db.Decimal(12, 2)
  savingsBalance             Decimal                    @db.Decimal(12, 2)
  savingsRetentionMultiplier Decimal                    @db.Decimal(5, 2)
  score                      Decimal                    @default(0) @db.Decimal(12, 2)
  nextDayAt                  DateTime?
  pausedAt                   DateTime?
  pausedDecisionSeconds      Int?
  presentationHold           SimulationPresentationHold @default(NONE)
  completionSnapshot         Json?
  completionRewardGrantedAt  DateTime?
  completedAt                DateTime?
  abandonedAt                DateTime?
  expiresAt                  DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligations         SimulationObligation[]
  obligationSchedules SimulationObligationSchedule[]
  events              SimulationEvent[]
  scoreEntries        SimulationScoreEntry[]
  actions             SimulationAction[]

  @@index([userId, status, updatedAt])
  @@index([status, nextDayAt])
  @@index([expiresAt])
}

model SimulationObligation {
  id                     String                     @id @default(uuid())
  sessionId              String
  templateCode           String
  name                   String
  category               String
  amountDue              Decimal                    @db.Decimal(12, 2)
  dueDay                 Int
  introducedByEventId    String?
  introducedByScheduleId String?                    @unique
  status                 SimulationObligationStatus @default(SCHEDULED)
  paidAt                 DateTime?
  currentUsed            Decimal                    @default(0) @db.Decimal(12, 2)
  savingsUsed            Decimal                    @default(0) @db.Decimal(12, 2)
  pointsAwarded          Decimal                    @default(0) @db.Decimal(12, 2)
  consequenceSnapshot    Json
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  session              SimulationSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  introducedByEvent    SimulationEvent?              @relation("EventIntroducedObligation", fields: [introducedByEventId], references: [id], onDelete: SetNull)
  introducedBySchedule SimulationObligationSchedule? @relation("ScheduleMaterializedObligation", fields: [introducedByScheduleId], references: [id], onDelete: SetNull)

  @@index([sessionId, dueDay, status])
  @@index([introducedByEventId])
}

model SimulationObligationSchedule {
  id                 String                             @id @default(uuid())
  sessionId          String
  scheduleKey        String
  templateCode       String
  triggerDay         Int
  status             SimulationObligationScheduleStatus @default(SCHEDULED)
  obligationSnapshot Json
  materializedAt     DateTime?
  createdAt          DateTime                           @default(now())
  updatedAt          DateTime                           @updatedAt

  session                SimulationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  materializedObligation SimulationObligation? @relation("ScheduleMaterializedObligation")

  @@unique([sessionId, scheduleKey])
  @@index([sessionId, triggerDay, status])
}

model SimulationEvent {
  id                 String                @id @default(uuid())
  sessionId          String
  templateCode       String
  triggerDay         Int
  status             SimulationEventStatus @default(SCHEDULED)
  eventSnapshot      Json
  revealedAt         DateTime?
  decisionExpiresAt  DateTime?
  selectedOptionId   String?
  resolvedAt         DateTime?
  resolutionSnapshot Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  session               SimulationSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  introducedObligations SimulationObligation[] @relation("EventIntroducedObligation")

  @@index([sessionId, triggerDay, status])
  @@index([status, decisionExpiresAt])
}

model SimulationScoreEntry {
  id              String                    @id @default(uuid())
  sessionId       String
  sourceType      SimulationScoreSourceType
  sourceId        String?
  simulatedDay    Int
  pointsDelta     Decimal                   @db.Decimal(12, 2)
  reason          String
  calculationData Json
  createdAt       DateTime                  @default(now())

  session SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, simulatedDay, createdAt])
  @@index([sourceType])
}

model SimulationAction {
  id               String               @id @default(uuid())
  sessionId        String
  actionType       SimulationActionType
  idempotencyKey   String
  payloadHash      String
  responseSnapshot Json?
  committedAt      DateTime             @default(now())

  session SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, actionType, committedAt])
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  sender      User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())
  user      User     @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

model Wager {
  id              String        @id @default(uuid())
  creatorId       String
  opponentId      String
  taskType        WagerTaskType
  stakeAmount     Int
  status          WagerStatus   @default(PENDING)
  startDate       DateTime?
  endDate         DateTime?
  durationDays    Int
  invitedAt       DateTime      @default(now())
  respondedAt     DateTime?
  resolvedAt      DateTime?
  creatorOutcome  WagerOutcome?
  opponentOutcome WagerOutcome?
  taskSnapshot    Json?
  creator         User          @relation("WagersCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent        User          @relation("WagersReceived", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@index([opponentId, status])
  @@index([status, endDate])
}
