generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Currency {
  ZAR
  USD
  EUR
  GBP
}

enum CategoryType {
  OBLIGATION
  EXPENSE
  BOTH
}

enum ObligationType {
  RENT
  SUBSCRIPTION
  BNPL
  UTILITY
  IOU
  CUSTOM
}

enum ObligationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ObligationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScheduleFrequency {
  ONCE
  WEEKLY
  MONTHLY
  FIXED_INSTALLMENT
}

enum PaymentOccurrenceStatus {
  PENDING
  PAID
  PAID_LATE
  OVERDUE
  MISSED
  CANCELLED
}

enum PaymentRecordStatus {
  ON_TIME
  LATE
}

enum ReminderChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum NotificationType {
  REMINDER
  SCORE_CHANGE
  REWARD
  BADGE_EARNED
  PAYMENT_STATUS
  SYSTEM
}

enum ScoreTier {
  BUILDING
  FAIR
  GOOD
  EXCELLENT
  ELITE
}

enum ScoreEventType {
  PAYMENT_ON_TIME
  PAYMENT_LATE
  PAYMENT_OVERDUE
  PAYMENT_MISSED
  MANUAL_ADJUSTMENT
}

enum MascotMood {
  HAPPY
  NEUTRAL
  STRESSED
  SAD
  CELEBRATING
}

enum UserEventType {
  USER_CREATED
  OBLIGATION_CREATED
  PAYMENT_LOGGED
  PAYMENT_ON_TIME
  PAYMENT_LATE
  PAYMENT_OVERDUE
  QUIZ_COMPLETED
  SCORE_UPDATED
  REWARD_GRANTED
  BADGE_EARNED
}

enum UserEventSourceType {
  USER
  FINANCIAL_OBLIGATION
  PAYMENT_OCCURRENCE
  PAYMENT_RECORD
  SCORE_EVENT
  QUIZ
  REWARD_TRANSACTION
  BADGE
  SYSTEM
}

enum QuizTopic {
  BUDGETING
  CREDIT_SCORE
  INTEREST
  DEBT
  BNPL
  SUBSCRIPTIONS
}

enum QuizSessionType {
  DAILY
  TOPIC
}

enum QuizSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum RewardTransactionType {
  EARNED
  SPENT
  ADJUSTED
}

enum BadgeCategory {
  PAYMENT
  STREAK
  OBLIGATION
  SCORE
  DEMO
}

enum BadgeCriteriaType {
  FIRST_OBLIGATION
  FIRST_ON_TIME_PAYMENT
  PAYMENT_STREAK_COUNT
  SCORE_REACHED
}

model User {
  id                     String                  @id @default(uuid())
  supabaseAuthId         String                  @unique
  email                  String                  @unique
  displayName            String?
  avatarUrl              String?
  monthlyBudget          Decimal?                @db.Decimal(12, 2)
  onboardingCompleted    Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  preference             UserPreference?
  notificationPreference NotificationPreference?
  creditProfile          CreditProfile?
  gamificationProfile    GamificationProfile?
  obligations            FinancialObligation[]
  paymentOccurrences     PaymentOccurrence[]
  paymentRecords         PaymentRecord[]
  reminders              Reminder[]
  notifications          Notification[]
  scoreEvents            ScoreEvent[]
  userEvents             UserEvent[]
  rewardTransactions     RewardTransaction[]
  badges                 UserBadge[]
  quizSessions           QuizSession[]

  @@index([email])
  @@index([deletedAt])
}

model UserPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  theme         Theme    @default(SYSTEM)
  currency      Currency @default(ZAR)
  language      String   @default("en")
  reducedMotion Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  emailEnabled              Boolean  @default(true)
  pushEnabled               Boolean  @default(false)
  smsEnabled                Boolean  @default(false)
  inAppEnabled              Boolean  @default(true)
  defaultReminderDaysBefore Int      @default(3)
  quietHoursStart           String?
  quietHoursEnd             String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String                @id @default(uuid())
  name        String
  type        CategoryType          @default(BOTH)
  iconKey     String?
  colourKey   String?
  isDefault   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  obligations FinancialObligation[]

  @@unique([name, type])
  @@index([isDefault])
}

model FinancialObligation {
  id          String              @id @default(uuid())
  userId      String
  categoryId  String
  name        String
  description String?
  type        ObligationType
  status      ObligationStatus    @default(ACTIVE)
  amount      Decimal             @db.Decimal(12, 2)
  currency    Currency            @default(ZAR)
  priority    ObligationPriority  @default(MEDIUM)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  schedules   PaymentSchedule[]
  occurrences PaymentOccurrence[]
  payments    PaymentRecord[]

  @@index([userId, deletedAt])
  @@index([userId, type])
  @@index([userId, status])
  @@index([categoryId])
}

model PaymentSchedule {
  id                        String              @id @default(uuid())
  obligationId              String
  frequency                 ScheduleFrequency
  interval                  Int                 @default(1)
  dayOfMonth                Int?
  dayOfWeek                 Int?
  startDate                 DateTime
  endDate                   DateTime?
  totalOccurrences          Int?
  occurrencesGeneratedUntil DateTime?
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  obligation                FinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  occurrences               PaymentOccurrence[]

  @@index([obligationId])
  @@index([isActive])
}

model PaymentOccurrence {
  id             String                  @id @default(uuid())
  userId         String
  obligationId   String
  scheduleId     String
  dueDate        DateTime
  amountDue      Decimal                 @db.Decimal(12, 2)
  currency       Currency                @default(ZAR)
  status         PaymentOccurrenceStatus @default(PENDING)
  sequenceNumber Int
  paidAt         DateTime?
  overdueAt      DateTime?
  missedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  obligation     FinancialObligation     @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  schedule       PaymentSchedule         @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  payment        PaymentRecord?
  reminders      Reminder[]
  scoreEvents    ScoreEvent[]

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([obligationId])
  @@index([scheduleId])
  @@index([deletedAt])
}

model PaymentRecord {
  id                String              @id @default(uuid())
  userId            String
  occurrenceId      String              @unique
  obligationId      String
  amountPaid        Decimal             @db.Decimal(12, 2)
  currency          Currency            @default(ZAR)
  paidDate          DateTime
  paymentStatus     PaymentRecordStatus
  daysLate          Int                 @default(0)
  simulatedInterest Decimal             @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurrence        PaymentOccurrence   @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  obligation        FinancialObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  scoreEvents       ScoreEvent[]

  @@index([userId, paidDate])
  @@index([userId, paymentStatus])
  @@index([obligationId])
  @@index([deletedAt])
}

model Reminder {
  id           String             @id @default(uuid())
  userId       String
  occurrenceId String
  channel      ReminderChannel    @default(IN_APP)
  scheduledFor DateTime
  sentAt       DateTime?
  status       ReminderStatus     @default(SCHEDULED)
  priority     ObligationPriority @default(MEDIUM)
  message      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurrence   PaymentOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)

  @@index([userId, scheduledFor])
  @@index([userId, status])
  @@index([occurrenceId])
  @@index([deletedAt])
}

model Notification {
  id         String               @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  sourceType UserEventSourceType?
  sourceId   String?
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  deletedAt  DateTime?
  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt])
  @@index([userId, type])
  @@index([sourceType, sourceId])
  @@index([deletedAt])
}

model CreditProfile {
  id                      String       @id @default(uuid())
  userId                  String       @unique
  currentScore            Int          @default(600)
  previousScore           Int          @default(600)
  scoreTier               ScoreTier    @default(GOOD)
  onTimePaymentCount      Int          @default(0)
  latePaymentCount        Int          @default(0)
  missedPaymentCount      Int          @default(0)
  currentUtilisationScore Decimal?     @db.Decimal(5, 2)
  lastCalculatedAt        DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?
  user                    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  scoreEvents             ScoreEvent[]

  @@index([scoreTier])
  @@index([deletedAt])
}

model ScoreEvent {
  id                  String             @id @default(uuid())
  userId              String
  creditProfileId     String
  occurrenceId        String?
  paymentRecordId     String?
  eventType           ScoreEventType
  pointsDelta         Int
  scoreBefore         Int
  scoreAfter          Int
  explanation         String
  calculationMetadata Json?
  createdAt           DateTime           @default(now())
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditProfile       CreditProfile      @relation(fields: [creditProfileId], references: [id], onDelete: Restrict)
  occurrence          PaymentOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  paymentRecord       PaymentRecord?     @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([creditProfileId])
  @@index([eventType])
}

model QuizQuestion {
  id               String              @id @default(uuid())
  topic            QuizTopic
  prompt           String
  options          Json
  correctOptionKey String
  explanation      String
  difficulty       Int                 @default(1)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessionAnswers   QuizSessionAnswer[]

  @@index([topic, isActive])
}

model QuizSession {
  id             String              @id @default(uuid())
  userId         String
  type           QuizSessionType
  topic          QuizTopic?
  quizDate       DateTime?
  status         QuizSessionStatus   @default(IN_PROGRESS)
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  score          Int                 @default(0)
  totalQuestions Int
  coinsAwarded   Int                 @default(0)
  xpAwarded      Int                 @default(0)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  answers        QuizSessionAnswer[]

  @@unique([userId, type, quizDate])
  @@index([userId, status])
  @@index([userId, quizDate])
}

model QuizSessionAnswer {
  id                String       @id @default(uuid())
  sessionId         String
  questionId        String
  selectedOptionKey String
  isCorrect         Boolean
  attemptNumber     Int
  answeredAt        DateTime     @default(now())
  session           QuizSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([sessionId, answeredAt])
  @@index([questionId])
}

model GamificationProfile {
  id                      String     @id @default(uuid())
  userId                  String     @unique
  coinBalance             Int        @default(0)
  xp                      Int        @default(0)
  mascotLevel             Int        @default(1)
  mascotMood              MascotMood @default(NEUTRAL)
  mascotMoodUpdatedAt     DateTime?
  currentPaymentStreak    Int        @default(0)
  longestPaymentStreak    Int        @default(0)
  currentKnowledgeStreak  Int        @default(0)
  longestKnowledgeStreak  Int        @default(0)
  lastKnowledgeStreakDate DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?
  user                    User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([mascotMood])
  @@index([deletedAt])
}

model UserEvent {
  id                 String              @id @default(uuid())
  userId             String
  eventType          UserEventType
  sourceType         UserEventSourceType
  sourceId           String?
  metadata           Json?
  createdAt          DateTime            @default(now())
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  rewardTransactions RewardTransaction[]

  @@index([userId, createdAt])
  @@index([eventType])
  @@index([sourceType, sourceId])
}

model RewardTransaction {
  id            String                @id @default(uuid())
  userId        String
  sourceEventId String?
  type          RewardTransactionType
  amount        Int
  balanceAfter  Int
  reason        String
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceEvent   UserEvent?            @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sourceEventId])
  @@index([type])
}

model BadgeDefinition {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  description   String
  category      BadgeCategory
  criteriaType  BadgeCriteriaType
  criteriaValue Int               @default(1)
  bonusCoins    Int               @default(0)
  iconKey       String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userBadges    UserBadge[]

  @@index([category])
  @@index([isActive])
}

model UserBadge {
  id                String          @id @default(uuid())
  userId            String
  badgeDefinitionId String
  progress          Int             @default(0)
  earnedAt          DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  badgeDefinition   BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([userId, badgeDefinitionId])
  @@index([userId, earnedAt])
  @@index([badgeDefinitionId])
}
